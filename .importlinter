[importlinter]
root_package = spatialmind

[importlinter:contract:contracts_keystone]
name = contracts must not import layer packages
type = forbidden
source_modules =
    spatialmind.contracts
forbidden_modules =
    spatialmind.agent
    spatialmind.api
    spatialmind.app
    spatialmind.batch
    spatialmind.ingestion
    spatialmind.memory
    spatialmind.storage
    spatialmind.tools
    spatialmind.viz

[importlinter:contract:tools_do_not_import_agent]
name = tools must not import the agent, API or app
type = forbidden
source_modules =
    spatialmind.tools
forbidden_modules =
    spatialmind.agent
    spatialmind.api
    spatialmind.app

[importlinter:contract:viz_storage_do_not_import_agent]
name = viz and storage are pure consumers
type = forbidden
source_modules =
    spatialmind.viz
    spatialmind.storage
forbidden_modules =
    spatialmind.agent
    spatialmind.api
    spatialmind.app

[importlinter:contract:app_is_the_top_layer]
name = the app is a top layer nothing else may import
type = forbidden
source_modules =
    spatialmind.ingestion
    spatialmind.pilot
    spatialmind.promotion
    spatialmind.methods
    spatialmind.review
forbidden_modules =
    spatialmind.app
